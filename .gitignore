# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# service account firebase (nunca subir)
service-account*.json
firebase-adminsdk*.json

# datos locales runtime
/data/orders.json
/data/products.json
/data/cj-token.json

# payloads de diagnóstico / dumps
/cocol_pdp_payload.json
*.payload.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.projects/cache
.projects/vault
.projects/state.test.json
.projects/state.local.test.json
.env
.env.*
!.env.example

# artefactos del navegador de auditoria (regenerables)
.playwright-mcp/

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# datos runtime locales (creados en dev; contienen hashes de contraseña)
/data/meta/
/data/admin_users/
/data/support_escalations/
