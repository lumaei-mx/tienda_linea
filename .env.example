# === CJ Dropshipping (elige UNA forma de auth) ===
# Opción A (recomendada): API Key → se obtiene access token automático
CJ_API_KEY=

# Opción B: access token directo (JWT)
# CJ_ACCESS_TOKEN=

# Opción C: refresh token
# CJ_REFRESH_TOKEN=

CJ_API_BASE=https://developers.cjdropshipping.com/api2.0/v1

# true = órdenes sandbox (sin cobro real en CJ)
CJ_SANDBOX=true

# true = paga con balance CJ al crear orden (¡dinero real!)
CJ_AUTO_PAY_BALANCE=false

# Markup sobre (costo + envío estimado) para precio venta
CJ_DEFAULT_MARKUP=2.6

# País origen envío
CJ_FROM_COUNTRY=CN
CJ_DEFAULT_LOGISTIC=CJPacket Ordinary

# Stripe (pagos cliente)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=whsec_...  # para verificar firma en /api/stripe/webhook

# === Email transaccional (Gmail SMTP) ===
# Sin GMAIL_APP_PASSWORD el envío se omite (no rompe el checkout).
# GMAIL_USER=
# GMAIL_APP_PASSWORD=  # password de aplicación de 16 caracteres (sin espacios)
# EMAIL_FROM=
# OWNER_EMAIL=  # destinatario del aviso de autorización de envío
NEXT_PUBLIC_SITE_URL=https://www.lumaei.com  # base para links "Ver mi pedido" / admin / afiliados

# === Canal de alertas push al dueño (Telegram) ===
# 1) Crear bot con @BotFather → obtener TELEGRAM_BOT_TOKEN
# 2) El dueño escribe al bot y se copia su chat_id en TELEGRAM_CHAT_ID
# Sin estas vars el push se omite (las alertas siguen en /admin).
# TELEGRAM_BOT_TOKEN=  # token del bot de @BotFather
# TELEGRAM_CHAT_ID=  # chat_id numérico del dueño

# === Firestore (persistencia en producción) ===
# Opción A: ruta al JSON de service account (local)
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/service-account.json

# Opción B: vars separadas (Vercel)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Opción C: JSON completo en una sola var (Vercel)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# ==== Almacenamiento (producción) ====
# URL de Redis (Upstash u otro). Sin REDIS_URL se usa memoria local (solo dev).
# REDIS_URL=redis://default:password@host:port

# ==== Autonomía de pedidos (documentado en src/lib/checkout.ts) ====
# false (por defecto) = el pedido pagado queda en `awaiting_owner_approval`
#   y el dueño autoriza desde /admin. true = se auto-aprueba y se envía a
#   cumplimiento CJ inmediatamente (gasta saldo real si CJ_AUTO_PAY_BALANCE=true).
# AUTO_APPROVE_ORDERS=false

# ==== Admin y crons (NUNCA commitear valores reales) ====
# ADMIN_PASSWORD=
# ADMIN_SECRET=
# CRON_SECRET=  # header x-cron-secret o ?secret en /api/cron/* y /api/health no lo usa
# CJ_WEBHOOK_SECRET=  # obligatorio: /api/cj/webhook rechaza 503 si no está definido; configurar header x-cj-webhook-secret en el panel CJ

# ==== Soporte autónomo (AgentMail) ====
# Sin estas vars el cron /api/cron/support responde { replied: 0, ... } sin romper.
# AGENTMAIL_API_KEY=
# AGENTMAIL_INBOX=
